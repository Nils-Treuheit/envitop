    Screen {
        background: #070b10;
        color: #d6e2ea;
    }
    #header {
        height: 2;
        padding: 0 1;
        background: #070b10;
    }
    #main {
        height: 1fr;
    }
    .col {
        height: 1fr;
        width: 1fr;
    }
    .panel {
        border: round #26414f;
        background: #0b1219;
        padding: 0 1;
        width: 1fr;
        height: 1fr;
    }
    .panel.active {
        border: round #3fd0c9;
    }
    .stat {
        height: 1;
    }
    #panel-cpu { height: 2.6fr; }
    #cpu-content { height: 1fr; }
    #cpu-top-row { height: 1fr; min-height: 4; }
    #cpu-core-scroll { height: 1fr; min-height: 4; overflow-y: auto; }
    #panel-cpu-aggregate { height: 1fr; min-width: 18; }
    #cpu-top-procs { height: 1fr; min-height: 3; }
    #panel-mem { height: 1.4fr; }
    #memory-content { height: 3.05fr; }
    #memory-lower { height: 1.65fr; }
    #panel-filesystems { height: 1fr; }
    #panel-net { height: 1.15fr; }
    #net-lower { height: 2.35fr; min-height: 4; }
    #panel-net-interfaces { min-width: 38; }
    #panel-websites { min-width: 38; }
    #panel-listeners { min-width: 32; }
    #panel-disk { height: 1.65fr; }
    #panel-gpu { height: 2.5fr; }
    #gpu-top { height: 2.5fr; }
    #panel-gpu-stats { width: 1fr; min-width: 28; }
    #panel-gpuprocs { height: 1.3fr; }
    #panel-procs { height: 1.45fr; }
    #panel-agents { height: 1.85fr; }
    #panel-tokens { height: 2.0fr; }
    #panel-detail { height: 1.3fr; }
    #panel-quota { height: 1.0fr; }
    #cpu-graph { width: 1fr; height: 1.5fr; min-height: 2; }
    #cpu-cores { width: 1fr; height: 1fr; min-height: 3; }
    #agent-content { height: 1fr; }
    #agents-row-top { height: 3.85fr; }
    #agents-row-bottom { height: 2.3fr; }
    #proc-summary { height: 1; }
    #net-details { height: 1fr; }
    #footer {
        height: 1;
        padding: 0 1;
        background: #0b1219;
        color: #7d93a3;
    }
    HelpScreen {
        align: center middle;
        background: #070b10 70%;
    }
    #help-box {
        width: 90%;
        max-width: 88;
        height: 90%;
        max-height: 40;
        border: round #3fd0c9;
        background: #0b1219;
        padding: 1 2;
        color: #d6e2ea;
        overflow-y: auto;
    }
    